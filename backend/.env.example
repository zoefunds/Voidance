# Server
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Postgres (Fly.io Postgres attached app, or local Docker for dev) — the
# ONLY hard external dependency, deliberately. No Redis: uptime must never
# be able to degrade because a cache/rate-limit store is unreachable.
DATABASE_URL=postgres://voidance:voidance@localhost:5432/voidance

# GenLayer StudioNet
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
VOIDANCE_CONTRACT_ADDRESS=0x9a6bCe6a759c6E9ca20d90ca593B759CfC5E4f77

# Indexer sync loop
SYNC_INTERVAL_MS=60000

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://voidance.vercel.app
