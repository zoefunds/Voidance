# Server
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Postgres (Fly.io Postgres attached app, or local Docker for dev)
DATABASE_URL=postgres://voidance:voidance@localhost:5432/voidance

# Redis (Upstash) — response cache + distributed rate-limit store. Optional
# for local dev (falls back to in-memory cache/limiter if unset), required
# in production so rate limiting and caching stay correct across restarts
# and any future multi-machine scale-out.
REDIS_URL=

# GenLayer StudioNet
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
VOIDANCE_CONTRACT_ADDRESS=0x58dED66906Ceb587236591C5d9729CE89501cbC2

# Indexer sync loop
SYNC_INTERVAL_MS=15000

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://voidance.vercel.app
